<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>The First Spark — Soul Maps</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,600;9..144,900&family=Space+Grotesk:wght@300;400;500;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{
  --void:#07070F;
  --field:#0C0C18;
  --panel:#13132A;
  --panel-2:#1B1B36;
  --edge:#26264A;
  --bone:#F4F5FA;
  --silver:#C6CBDA;
  --dim:#6E7590;

  /* Color Codex — 11 canonical tiers */
  --c1:#E03B3B; --c2:#F07A2D; --c3:#F2B33D; --c4:#4CB963; --c5:#2FC6C6;
  --c6:#3D7BE0; --c7:#5A4BE0; --c8:#8B4BE0; --c9:#C24BD6; --c10:#F26D9B; --c11:#F4F5FA;

  --display:'Fraunces',Georgia,'Times New Roman',serif;
  --body:'Space Grotesk',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,sans-serif;
  --mono:'JetBrains Mono',ui-monospace,'SF Mono',Menlo,monospace;

  --gutter:clamp(1.25rem,5vw,5.5rem);
}

*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  background:var(--void); color:var(--bone);
  font-family:var(--body); font-weight:300;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
::selection{background:var(--c8);color:#fff}
:focus-visible{outline:2px solid var(--c5);outline-offset:4px;border-radius:2px}

/* ---------- ambient field ---------- */
#stars{position:fixed;inset:0;z-index:0;pointer-events:none}
.nebula{
  position:fixed;z-index:0;pointer-events:none;border-radius:50%;
  filter:blur(90px);opacity:.5;
}
.nebula.a{width:44vw;height:44vw;top:-12vw;left:-8vw;
  background:radial-gradient(circle,rgba(139,75,224,.42),transparent 68%)}
.nebula.b{width:52vw;height:52vw;bottom:-20vw;right:-14vw;
  background:radial-gradient(circle,rgba(47,198,198,.26),transparent 68%)}
.nebula.c{width:34vw;height:34vw;top:38%;right:24%;
  background:radial-gradient(circle,rgba(242,109,155,.18),transparent 70%)}

/* ---------- scaffold ---------- */
.deck{position:relative;z-index:2;scroll-snap-type:y proximity}
.slide{
  min-height:100vh;scroll-snap-align:start;
  padding:clamp(4.5rem,9vh,7rem) var(--gutter) clamp(3.5rem,7vh,5rem);
  display:flex;flex-direction:column;justify-content:center;
  position:relative;max-width:1500px;margin:0 auto;
}

/* ---------- HUD ---------- */
.hud{
  position:fixed;right:clamp(.65rem,2vw,1.6rem);top:50%;transform:translateY(-50%);
  z-index:40;display:flex;flex-direction:column;gap:.68rem;align-items:center;
}
.hud button{
  width:9px;height:9px;border-radius:50%;border:0;padding:0;cursor:pointer;
  background:#2A2A4C;transition:transform .3s cubic-bezier(.2,.9,.3,1),box-shadow .3s,background .3s;
}
.hud button:hover{transform:scale(1.65)}
.hud button[aria-current="true"]{transform:scale(1.9)}
.mark{
  position:fixed;left:var(--gutter);top:1.7rem;z-index:40;
  font-family:var(--body);font-size:.62rem;font-weight:500;
  letter-spacing:.42em;color:var(--silver);text-transform:uppercase;
  display:flex;align-items:center;gap:.7rem;
}
.mark i{width:7px;height:7px;border-radius:50%;background:var(--c3);display:block;
  box-shadow:0 0 14px var(--c3);animation:pulse 3.4s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.32}}
.store{
  position:fixed;right:var(--gutter);top:1.42rem;z-index:41;
  display:inline-flex;align-items:center;gap:.55rem;text-decoration:none;
  font-family:var(--body);font-size:.62rem;font-weight:500;
  letter-spacing:.28em;text-transform:uppercase;color:var(--silver);
  border:1px solid var(--edge);border-radius:999px;padding:.52rem 1rem .52rem .85rem;
  background:rgba(12,12,24,.62);backdrop-filter:blur(9px);-webkit-backdrop-filter:blur(9px);
  transition:color .4s ease,border-color .4s ease,transform .4s cubic-bezier(.16,1,.3,1),
             box-shadow .4s ease;
}
.store i{
  width:6px;height:6px;border-radius:50%;background:var(--c3);flex:none;
  box-shadow:0 0 10px var(--c3);transition:box-shadow .4s ease;
}
.store u{text-decoration:none;transition:transform .4s cubic-bezier(.16,1,.3,1);display:block}
.store:hover{
  color:var(--bone);border-color:var(--c3);transform:translateY(-2px);
  box-shadow:0 10px 30px -12px rgba(242,179,61,.55);
}
.store:hover i{box-shadow:0 0 18px 3px var(--c3)}
.store:hover u{transform:translate(2px,-2px)}

.counter{
  position:fixed;right:clamp(.65rem,2vw,1.6rem);bottom:1.6rem;z-index:40;
  font-family:var(--mono);font-size:.62rem;color:var(--dim);letter-spacing:.14em;
}

/* ---------- type ---------- */
.eyebrow{
  font-size:.6rem;font-weight:500;letter-spacing:.42em;text-transform:uppercase;
  margin-bottom:1.5rem;display:flex;align-items:center;gap:.6rem;
}
.eyebrow::before{content:"";width:22px;height:1px;background:currentColor;opacity:.55}
h1{
  font-family:var(--display);font-weight:900;
  font-size:clamp(3.1rem,10.5vw,9.4rem);line-height:.82;letter-spacing:-.035em;
}
h2{
  font-family:var(--display);font-weight:600;
  font-size:clamp(1.85rem,4.6vw,3.7rem);line-height:1.02;letter-spacing:-.022em;
  max-width:17ch;
}
h2 em{font-style:italic;font-weight:300}
.lede{
  font-size:clamp(.94rem,1.28vw,1.13rem);line-height:1.62;color:var(--silver);
  max-width:62ch;margin-top:1.4rem;font-weight:300;
}
.note{font-size:.72rem;color:var(--dim);letter-spacing:.04em;line-height:1.6}

/* ---------- reveal ---------- */
.rv{opacity:0;transform:translateY(26px);transition:opacity .85s cubic-bezier(.16,1,.3,1),transform .85s cubic-bezier(.16,1,.3,1)}
.rv.in{opacity:1;transform:none}

/* =========================================================
   01 — SINGULARITY / COVER
   ========================================================= */
.cover{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(2rem,5vw,5rem);align-items:center}
.cover-l{position:relative;z-index:3}
h1 .glow{
  display:block;
  background:linear-gradient(96deg,var(--c11) 6%,var(--c8) 46%,var(--c5) 78%,var(--c3) 100%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.tagline{
  font-family:var(--display);font-style:italic;font-weight:300;
  font-size:clamp(1.05rem,2.05vw,1.62rem);color:var(--c3);
  margin-top:1.7rem;letter-spacing:-.01em;
}
.byline{margin-top:2.6rem;padding-top:1.5rem;border-top:1px solid var(--edge);max-width:34rem}
.byline strong{font-weight:500;font-size:.88rem;letter-spacing:.02em}
.byline span{display:block;color:var(--dim);font-size:.78rem;margin-top:.42rem;letter-spacing:.05em}

/* the black hole */
.hole-wrap{position:relative;display:grid;place-items:center;aspect-ratio:1;
  min-height:min(56vh,460px);perspective:900px}
.hole{position:relative;width:min(30vw,340px);aspect-ratio:1;display:grid;place-items:center;
  cursor:crosshair}
.disk{
  position:absolute;inset:-34%;border-radius:50%;
  background:conic-gradient(from 0deg,
    transparent 0deg,var(--c1) 24deg,var(--c3) 62deg,var(--c11) 96deg,
    var(--c5) 138deg,var(--c8) 196deg,var(--c9) 246deg,transparent 316deg);
  filter:blur(20px);opacity:.72;
  animation:spin 16s linear infinite;
  transition:filter .6s ease,opacity .6s ease;
}
.disk.two{inset:-14%;filter:blur(9px);opacity:.62;animation-duration:9s;animation-direction:reverse}
@keyframes spin{to{transform:rotate(360deg)}}
.photon{
  position:absolute;inset:2%;border-radius:50%;
  box-shadow:0 0 0 1px rgba(244,245,250,.55),0 0 42px 5px rgba(139,75,224,.55),
             inset 0 0 34px 3px rgba(47,198,198,.28);
}
.core{
  position:relative;width:100%;height:100%;border-radius:50%;
  background:radial-gradient(circle at 50% 50%,#000 62%,rgba(0,0,0,.86) 82%,transparent 100%);
  display:grid;place-items:center;z-index:2;
}
.core small{
  font-family:var(--mono);font-size:.56rem;letter-spacing:.32em;color:var(--dim);
  text-transform:uppercase;opacity:0;transition:opacity .5s ease;text-align:center;line-height:1.9
}
.hole:hover .core small{opacity:1}
.hole:hover .disk{filter:blur(11px);opacity:1}
.hole-cap{
  position:absolute;bottom:-.4rem;left:50%;transform:translateX(-50%);
  font-family:var(--mono);font-size:.58rem;letter-spacing:.2em;color:var(--dim);white-space:nowrap
}

/* =========================================================
   shared cards
   ========================================================= */
.grid{display:grid;gap:clamp(.7rem,1.1vw,1rem);margin-top:clamp(1.8rem,4vh,3rem)}
.g3{grid-template-columns:repeat(3,1fr)}
.g4{grid-template-columns:repeat(4,1fr)}
.g2{grid-template-columns:repeat(2,1fr)}

.card{
  position:relative;background:var(--panel);border:1px solid var(--edge);
  border-radius:15px;padding:1.5rem 1.35rem;overflow:hidden;
  transition:transform .45s cubic-bezier(.16,1,.3,1),border-color .45s,background .45s;
}
.card::after{
  content:"";position:absolute;inset:0;border-radius:15px;pointer-events:none;
  background:radial-gradient(340px circle at var(--mx,50%) var(--my,0%),
    color-mix(in srgb,var(--tone) 20%,transparent),transparent 62%);
  opacity:0;transition:opacity .45s ease;
}
.card:hover{transform:translateY(-7px);border-color:color-mix(in srgb,var(--tone) 55%,var(--edge));
  background:var(--panel-2)}
.card:hover::after{opacity:1}
.card h3{
  font-family:var(--display);font-weight:600;font-size:1.06rem;letter-spacing:-.01em;
  margin-bottom:.6rem;display:flex;align-items:center;gap:.62rem;
}
.card h3 i{width:9px;height:9px;border-radius:50%;background:var(--tone);flex:none;
  box-shadow:0 0 0 0 var(--tone);transition:box-shadow .45s ease}
.card:hover h3 i{box-shadow:0 0 16px 2px var(--tone)}
.card p{font-size:.815rem;line-height:1.68;color:var(--silver);font-weight:300}
.card .k{
  position:absolute;top:1.15rem;right:1.25rem;font-family:var(--mono);
  font-size:.58rem;color:var(--dim);letter-spacing:.1em;
  opacity:0;transform:translateX(6px);transition:opacity .4s ease,transform .4s ease;
}
.card:hover .k{opacity:1;transform:none}

/* =========================================================
   04 — the specimen (sample Soul Map)
   ========================================================= */
.spec-wrap{display:grid;grid-template-columns:.82fr 1.18fr;gap:clamp(1.2rem,3vw,2.6rem);
  margin-top:clamp(1.4rem,3.5vh,2.4rem);align-items:start}

.layers{display:flex;flex-direction:column;gap:2px}
.layer{
  display:flex;align-items:center;gap:.75rem;padding:.62rem .8rem;border-radius:9px;
  cursor:pointer;border:1px solid transparent;
  transition:background .35s ease,border-color .35s ease,transform .35s cubic-bezier(.16,1,.3,1);
}
.layer:hover,.layer.on{background:var(--panel);border-color:color-mix(in srgb,var(--tone) 46%,var(--edge));
  transform:translateX(5px)}
.layer i{width:8px;height:8px;border-radius:50%;background:var(--tone);flex:none;
  transition:box-shadow .35s ease}
.layer:hover i,.layer.on i{box-shadow:0 0 13px 2px var(--tone)}
.layer b{font-family:var(--body);font-weight:400;font-size:.83rem;letter-spacing:.01em}
.layer em{margin-left:auto;font-family:var(--mono);font-size:.55rem;color:var(--dim);
  font-style:normal;letter-spacing:.12em}

.spec{
  border:1px solid var(--edge);border-radius:18px;overflow:hidden;
  background:linear-gradient(168deg,var(--panel) 0%,rgba(12,12,24,.94) 100%);
  box-shadow:0 32px 90px -30px rgba(0,0,0,.9);
}
.spec-head{
  padding:1.15rem 1.4rem;border-bottom:1px solid var(--edge);
  display:flex;justify-content:space-between;align-items:baseline;gap:1rem;flex-wrap:wrap;
}
.spec-head h3{font-family:var(--display);font-weight:600;font-size:1.02rem;letter-spacing:-.01em}
.spec-head p{font-family:var(--mono);font-size:.55rem;color:var(--dim);letter-spacing:.14em;
  text-transform:uppercase}
.spec-body{padding:1.25rem 1.4rem 1.5rem}

.blk{
  padding:.85rem .95rem;border-radius:11px;border:1px solid transparent;margin-bottom:.42rem;
  transition:background .4s ease,border-color .4s ease;
}
.blk.on{background:rgba(255,255,255,.032);border-color:color-mix(in srgb,var(--tone) 52%,transparent)}
.blk h5{
  font-family:var(--mono);font-size:.52rem;letter-spacing:.22em;text-transform:uppercase;
  color:var(--dim);font-weight:400;margin-bottom:.6rem;display:flex;align-items:center;gap:.5rem;
}
.blk.on h5{color:var(--tone)}

.hero-row{display:flex;gap:1.5rem;align-items:flex-end;flex-wrap:wrap}
.hero-row .sigval{
  font-family:var(--mono);font-weight:700;font-size:clamp(1.15rem,2.5vw,1.7rem);
  letter-spacing:.05em;color:var(--bone);
}
.hero-row .hz{font-family:var(--display);font-weight:900;font-size:clamp(1.3rem,2.9vw,2rem);
  color:var(--c8);letter-spacing:-.02em;line-height:1}

.pairs{display:grid;grid-template-columns:repeat(auto-fit,minmax(88px,1fr));gap:.55rem .9rem}
.pair{display:flex;flex-direction:column;gap:.2rem}
.pair span{font-family:var(--mono);font-size:.5rem;letter-spacing:.14em;color:var(--dim);
  text-transform:uppercase}
.pair b{font-size:.88rem;font-weight:500;letter-spacing:.01em}

.swatch-row{display:flex;align-items:center;gap:.7rem}
.awaiting{
  display:inline-flex;align-items:center;gap:.55rem;
  border:1px dashed #33335C;border-radius:8px;padding:.4rem .75rem;
  font-family:var(--mono);font-size:.56rem;letter-spacing:.14em;color:var(--dim);
  text-transform:uppercase;
}
.awaiting::before{content:"";width:14px;height:14px;border-radius:4px;
  background:repeating-linear-gradient(45deg,#22224A 0 4px,transparent 4px 8px)}

.lineage{display:flex;flex-direction:column;gap:.3rem}
.lineage b{font-size:.9rem;font-weight:500}
.lineage span{font-size:.75rem;color:var(--silver);font-weight:300;line-height:1.55}
.lineage .same{
  margin-top:.5rem;font-family:var(--mono);font-size:.54rem;letter-spacing:.1em;color:var(--c5);
}
.interp{font-size:.815rem;line-height:1.7;color:var(--silver);font-weight:300}
.interp em{font-style:italic;color:var(--bone)}

/* =========================================================
   05 — Codex spectrum
   ========================================================= */
.codex{display:flex;gap:5px;height:clamp(9rem,26vh,15rem);margin-top:2.4rem}
.tier{
  flex:1;border-radius:11px;position:relative;cursor:pointer;
  transition:flex .55s cubic-bezier(.16,1,.3,1),opacity .45s ease,box-shadow .45s ease;
  display:flex;align-items:flex-end;padding:.85rem;overflow:hidden;
}
.tier span{
  font-family:var(--mono);font-size:.6rem;color:rgba(7,7,15,.78);font-weight:700;
  letter-spacing:.08em;opacity:0;transform:translateY(8px);
  transition:opacity .4s ease .1s,transform .4s ease .1s;white-space:nowrap;
}
.codex:hover .tier{opacity:.34}
.codex .tier:hover{flex:3.1;opacity:1;box-shadow:0 16px 46px -12px currentColor}
.tier:hover span{opacity:1;transform:none}

/* =========================================================
   05 — Quantum signature
   ========================================================= */
.sigbox{
  margin-top:2.2rem;border:1px solid var(--edge);border-radius:19px;
  background:linear-gradient(180deg,var(--panel) 0%,rgba(19,19,42,.4) 100%);
  padding:clamp(1.8rem,4.5vh,3.1rem) clamp(1.2rem,3vw,2.6rem);
  text-align:center;cursor:pointer;position:relative;overflow:hidden;
  transition:border-color .5s ease;
}
.sigbox:hover{border-color:var(--c8)}
.sig{
  font-family:var(--mono);font-weight:700;
  font-size:clamp(1.7rem,6.4vw,4.4rem);letter-spacing:.055em;line-height:1;
  display:flex;justify-content:center;align-items:center;gap:clamp(.5rem,2vw,1.5rem);
  flex-wrap:wrap;
}
.sig b{font-weight:700}
.sig .b1{color:var(--c5)} .sig .b2{color:var(--c8)} .sig .b3{color:var(--c3)}
.sig .dot{color:var(--dim);font-weight:400}
.siglabels{
  display:flex;justify-content:center;gap:clamp(1rem,6vw,5.4rem);margin-top:1.15rem;
  font-family:var(--mono);font-size:.55rem;letter-spacing:.24em;color:var(--dim);
  text-transform:uppercase;flex-wrap:wrap;
}
.sighint{margin-top:1.5rem;font-size:.74rem;color:var(--dim);letter-spacing:.03em}
.sighint b{color:var(--c5);font-weight:400}

/* =========================================================
   06 — souls on chain
   ========================================================= */
.chain{
  position:relative;margin-top:clamp(2rem,5vh,3.4rem);
  padding:clamp(2.2rem,6vh,3.6rem) 0;
}
.rail{
  position:absolute;left:0;right:0;top:50%;height:1px;
  background:linear-gradient(90deg,transparent,var(--edge) 12%,var(--edge) 88%,transparent);
}
.pulse{
  position:absolute;top:50%;left:0;width:7px;height:7px;margin-top:-3px;border-radius:50%;
  background:var(--c5);box-shadow:0 0 18px 4px var(--c5);
  animation:travel 6.5s cubic-bezier(.6,0,.4,1) infinite;
}
@keyframes travel{0%{left:2%;opacity:0}8%{opacity:1}92%{opacity:1}100%{left:98%;opacity:0}}
.souls{position:relative;display:flex;justify-content:space-between;align-items:center}
.soul{
  position:relative;width:clamp(46px,7vw,74px);aspect-ratio:1;border-radius:50%;
  background:var(--field);border:1px solid var(--edge);
  display:grid;place-items:center;cursor:pointer;
  transition:transform .45s cubic-bezier(.16,1,.3,1),border-color .45s,box-shadow .45s;
}
.soul i{width:38%;aspect-ratio:1;border-radius:50%;background:var(--tone);
  transition:box-shadow .45s ease,transform .45s ease}
.soul:hover{transform:scale(1.18);border-color:var(--tone);
  box-shadow:0 0 0 6px color-mix(in srgb,var(--tone) 12%,transparent)}
.soul:hover i{box-shadow:0 0 22px 5px var(--tone)}
.soul::before{
  content:"BOUND";position:absolute;top:-1.9rem;left:50%;transform:translateX(-50%) translateY(5px);
  font-family:var(--mono);font-size:.5rem;letter-spacing:.24em;color:var(--tone);
  opacity:0;transition:opacity .4s ease,transform .4s ease;pointer-events:none;
}
.soul:hover::before{opacity:1;transform:translateX(-50%)}
.soul::after{
  content:attr(data-sig);position:absolute;bottom:-2.05rem;left:50%;
  transform:translateX(-50%) translateY(-5px);
  font-family:var(--mono);font-size:.53rem;letter-spacing:.1em;color:var(--dim);
  opacity:0;transition:opacity .4s ease,transform .4s ease;white-space:nowrap;pointer-events:none;
}
.soul:hover::after{opacity:1;transform:translateX(-50%)}
.soul.void{border-style:dashed;border-color:#2A2A4C;opacity:.42}
.soul.void i{background:transparent;box-shadow:inset 0 0 0 1px #2A2A4C}
.soul.void::before{content:"ERASED";color:var(--dim)}

.versus{display:grid;grid-template-columns:1fr 1fr;gap:clamp(.7rem,1.1vw,1rem);margin-top:2.6rem}
.vs{border:1px solid var(--edge);border-radius:15px;padding:1.4rem 1.35rem;background:var(--panel)}
.vs h4{font-family:var(--display);font-weight:600;font-size:1rem;margin-bottom:.55rem;
  display:flex;align-items:center;gap:.55rem}
.vs h4 b{font-family:var(--mono);font-size:.9rem;font-weight:700}
.vs.no h4 b{color:var(--c1)} .vs.yes h4 b{color:var(--c4)}
.vs p{font-size:.805rem;line-height:1.68;color:var(--silver);font-weight:300}

/* =========================================================
   07 — pipeline
   ========================================================= */
.pipe{display:grid;grid-template-columns:repeat(5,1fr);gap:.6rem;margin-top:2.4rem}
.step{
  background:var(--panel);border:1px solid var(--edge);border-radius:14px;
  padding:1.3rem 1.05rem;position:relative;
  transition:transform .45s cubic-bezier(.16,1,.3,1),border-color .45s,background .45s;
}
.step:hover{transform:translateY(-7px);border-color:var(--tone);background:var(--panel-2)}
.step .n{font-family:var(--mono);font-size:.58rem;color:var(--dim);letter-spacing:.14em}
.step h3{font-family:var(--display);font-weight:600;font-size:1.02rem;margin:.6rem 0 .5rem}
.step p{font-size:.755rem;line-height:1.6;color:var(--silver);font-weight:300}
.step .st{
  margin-top:.95rem;font-family:var(--mono);font-size:.53rem;letter-spacing:.16em;
  color:var(--tone);display:flex;align-items:center;gap:.4rem;
}
.step .st::before{content:"";width:5px;height:5px;border-radius:50%;background:var(--tone);
  box-shadow:0 0 9px var(--tone)}

/* =========================================================
   08 — traction
   ========================================================= */
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(.7rem,1.1vw,1rem)}
