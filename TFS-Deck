    W = cv.width = innerWidth; H = cv.height = innerHeight;
    const n = Math.min(200, Math.round(innerWidth * innerHeight / 9500));
    stars = Array.from({length:n}, () => ({
      x: Math.random()*W, y: Math.random()*H,
      r: Math.random()*1.25 + .25, d: Math.random()*.55 + .18,
      t: Math.random()*Math.PI*2
    }));
  }
  function drawStars(){
    cx.clearRect(0,0,W,H);
    for (const s of stars){
      s.t += 0.012;
      const tw = 0.45 + Math.sin(s.t)*0.35;
      cx.beginPath();
      cx.arc(s.x + mx*s.d*14, s.y + my*s.d*14, s.r, 0, Math.PI*2);
      cx.fillStyle = 'rgba(244,245,250,' + (tw*s.d).toFixed(3) + ')';
      cx.fill();
    }
    requestAnimationFrame(drawStars);
  }
  sizeStars();
  addEventListener('resize', sizeStars);
  if (!reduce){
    addEventListener('mousemove', e => {
      mx = (e.clientX / innerWidth - .5) * 2;
      my = (e.clientY / innerHeight - .5) * 2;
    }, {passive:true});
    drawStars();
  } else {
    cx.clearRect(0,0,W,H);
    for (const s of stars){
      cx.beginPath(); cx.arc(s.x,s.y,s.r,0,Math.PI*2);
      cx.fillStyle='rgba(244,245,250,.4)'; cx.fill();
    }
  }

  /* ---------- Color Codex ---------- */
  const NAMES = ['Tier I','Tier II','Tier III','Tier IV','Tier V','Tier VI',
                 'Tier VII','Tier VIII','Tier IX','Tier X','Tier XI'];
  const codex = document.getElementById('codex');
  TIERS.forEach((v,i) => {
    const d = document.createElement('div');
    d.className = 'tier';
    d.style.background = 'var(' + v + ')';
    d.style.color = 'var(' + v + ')';
    d.tabIndex = 0;
    d.innerHTML = '<span>' + NAMES[i] + '</span>';
    codex.appendChild(d);
  });

  /* ---------- spectrum rule (closing) ---------- */
  const rule = document.getElementById('rule');
  TIERS.forEach(v => {
    const i = document.createElement('i');
    i.style.background = 'var(' + v + ')';
    rule.appendChild(i);
  });

  /* ---------- souls on chain ---------- */
  const SOULS = [
    {t:'--c3',  sig:'Player One · 3058 · 7C40 · 4'},
    {t:'--c8',  sig:'minted · non-transferable'},
    {t:'--c5',  sig:'minted · non-transferable'},
    {t:'--c10', sig:'minted · non-transferable'},
    {t:'--c4',  sig:'minted · non-transferable'},
    {t:'--c6',  sig:'minted · non-transferable'},
    {t:null,    sig:'never minted · lost to the void'}
  ];
  const soulRow = document.getElementById('souls');
  SOULS.forEach(s => {
    const d = document.createElement('div');
    d.className = 'soul' + (s.t ? '' : ' void');
    if (s.t) d.style.setProperty('--tone','var(' + s.t + ')');
    d.setAttribute('data-sig', s.sig);
    d.tabIndex = 0;
    d.innerHTML = '<i></i>';
    soulRow.appendChild(d);
  });

  /* ---------- specimen: layer index <-> artifact block ---------- */
  const layerEls = [...document.querySelectorAll('.layer')];
  function focusLayer(el){
    layerEls.forEach(l => l.classList.remove('on'));
    document.querySelectorAll('.blk').forEach(b => b.classList.remove('on'));
    if (!el) return;
    el.classList.add('on');
    const blk = document.getElementById(el.dataset.blk);
    if (blk) blk.classList.add('on');
  }
  layerEls.forEach(el => {
    el.tabIndex = 0;
    el.addEventListener('mouseenter', () => focusLayer(el));
    el.addEventListener('focus', () => focusLayer(el));
  });
  const layerBox = document.getElementById('layers');
  if (layerBox) layerBox.addEventListener('mouseleave', () => focusLayer(null));

  /* ---------- deterministic signature scramble ---------- */
  const GLYPHS = '0123456789ABCDEF';
  const sigEls = document.querySelectorAll('.sig [data-target]');
  let running = false;
  function resolveSig(){
    if (running || reduce){
      if (reduce) sigEls.forEach(el => el.textContent = el.dataset.target);
      return;
    }
    running = true;
    const start = performance.now(), DUR = 1100;
    function frame(now){
      const p = Math.min(1, (now - start) / DUR);
      sigEls.forEach(el => {
        const target = el.dataset.target;
        let out = '';
        for (let i = 0; i < target.length; i++){
          // each character locks in sequence — resolution, not randomness
          const lockAt = (i + 1) / (target.length + 1);
          out += (p >= lockAt) ? target[i]
                               : GLYPHS[(Math.random()*16)|0];
        }
        el.textContent = out;
      });
      if (p < 1) requestAnimationFrame(frame);
      else { sigEls.forEach(el => el.textContent = el.dataset.target); running = false; }
    }
    requestAnimationFrame(frame);
  }
  const sigbox = document.getElementById('sigbox');
  sigbox.addEventListener('mouseenter', resolveSig);
  sigbox.addEventListener('click', resolveSig);
  sigbox.addEventListener('keydown', e => {
    if (e.key === 'Enter' || e.key === ' '){ e.preventDefault(); resolveSig(); }
  });

  /* ---------- pointer-tracked card glow ---------- */
  document.querySelectorAll('[data-tilt]').forEach(el => {
    el.addEventListener('mousemove', e => {
      const r = el.getBoundingClientRect();
      el.style.setProperty('--mx', ((e.clientX - r.left) / r.width * 100) + '%');
      el.style.setProperty('--my', ((e.clientY - r.top) / r.height * 100) + '%');
    }, {passive:true});
  });

  /* ---------- reveal on enter ---------- */
  const revealer = new IntersectionObserver(entries => {
    entries.forEach(en => {
      if (en.isIntersecting){
        const kids = [...en.target.querySelectorAll('.rv')];
        kids.forEach((k,i) => setTimeout(() => k.classList.add('in'), reduce ? 0 : i*85));
        revealer.unobserve(en.target);
      }
    });
  }, {threshold:.16});
  const slides = [...document.querySelectorAll('.slide')];
  slides.forEach(s => revealer.observe(s));

  /* ---------- HUD nav ---------- */
  const hud = document.getElementById('hud'), counter = document.getElementById('counter');
  slides.forEach((s,i) => {
    const b = document.createElement('button');
    b.style.setProperty('--tone', 'var(' + TIERS[i % TIERS.length] + ')');
    b.setAttribute('aria-label', 'Go to ' + s.dataset.label);
    b.title = s.dataset.label;
    b.addEventListener('click', () => s.scrollIntoView({behavior: reduce ? 'auto' : 'smooth'}));
    hud.appendChild(b);
  });
  const dots = [...hud.children];
  function paint(i){
    dots.forEach((d,j) => {
      const on = j === i;
      d.setAttribute('aria-current', on ? 'true' : 'false');
      const col = cssv(TIERS[j % TIERS.length]);
      d.style.background = on ? col : '#2A2A4C';
      d.style.boxShadow = on ? '0 0 14px ' + col : 'none';
    });
    counter.textContent = String(i+1).padStart(2,'0') + ' / ' + String(slides.length).padStart(2,'0');
  }
  let current = 0;
  const tracker = new IntersectionObserver(entries => {
    entries.forEach(en => {
      if (en.isIntersecting){
        current = slides.indexOf(en.target);
        paint(current);
      }
    });
  }, {threshold:.5});
  slides.forEach(s => tracker.observe(s));
  paint(0);

  /* ---------- keyboard ---------- */
  addEventListener('keydown', e => {
    const tag = (e.target.tagName || '').toLowerCase();
    if (tag === 'input' || tag === 'textarea') return;
    let next = null;
    if (e.key === 'ArrowDown' || e.key === 'PageDown') next = current + 1;
    if (e.key === 'ArrowUp'   || e.key === 'PageUp')   next = current - 1;
    if (e.key === 'Home') next = 0;
    if (e.key === 'End')  next = slides.length - 1;
    if (next !== null && slides[next]){
      e.preventDefault();
      slides[next].scrollIntoView({behavior: reduce ? 'auto' : 'smooth'});
    }
  });
})();
</script>
</body>
</html>
