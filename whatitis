  /* shipped grid */
  .grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
    gap:1px;
    margin-top:64px;
    background:rgba(255,255,255,0.08);
    border:1px solid rgba(255,255,255,0.08);
  }
  .card{
    background:var(--void);
    padding:34px 30px;
    position:relative;
    transition:background 0.4s ease;
    display:block;
    text-decoration:none;
    color:inherit;
  }
  .card:hover{background:var(--void-2);}
  .card::before{
    content:'';
    position:absolute;
    top:0;left:0;
    width:100%;height:2px;
    background:var(--accent, var(--ember));
    transform:scaleX(0);
    transform-origin:left;
    transition:transform 0.45s cubic-bezier(.2,.8,.2,1);
  }
  .card:hover::before{transform:scaleX(1);}
  .card .tag{
    font-family:'Space Mono',monospace;
    font-size:0.66rem;
    letter-spacing:0.18em;
    text-transform:uppercase;
    color:var(--accent, var(--ember));
    margin-bottom:16px;
    display:block;
  }
  .card h3{
    font-size:1.5rem;
    font-weight:500;
    margin-bottom:10px;
  }
  .card p{
    color:var(--ink-dim);
    font-size:1.02rem;
    line-height:1.5;
  }
  .card .stat{
    font-family:'Space Mono',monospace;
    font-size:2rem;
    color:var(--ink);
    margin-bottom:6px;
  }

  /* color codex strip - interactive voids */
  .codex-strip{
    display:flex;
    gap:10px;
    margin-top:56px;
    flex-wrap:wrap;
  }
  .codex-orb{
    flex:1;
    min-width:70px;
    height:88px;
    border-radius:999px;
    position:relative;
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
    transition:transform 0.35s cubic-bezier(.2,.8,.2,1), box-shadow 0.35s ease;
    border:1px solid rgba(255,255,255,0.12);
  }
  .codex-orb:hover{transform:translateY(-10px) scale(1.05);}
  .codex-orb .label{
    font-family:'Space Mono',monospace;
    font-size:0.6rem;
    letter-spacing:0.05em;
    color:rgba(255,255,255,0.85);
    text-transform:uppercase;
    opacity:0;
    transition:opacity 0.3s ease;
    position:absolute;
    bottom:-22px;
    white-space:nowrap;
  }
  .codex-orb:hover .label{opacity:1;}

  /* roadmap phases */
  .phases{margin-top:60px;}
  .phase{
    display:grid;
    grid-template-columns:70px 1fr;
    gap:24px;
    padding:26px 0;
    border-top:1px solid rgba(255,255,255,0.08);
    position:relative;
  }
  .phase:last-child{border-bottom:1px solid rgba(255,255,255,0.08);}
  .phase .num{
    font-family:'Space Mono',monospace;
    font-size:0.85rem;
    color:var(--ink-dim);
    padding-top:4px;
  }
  .phase h4{
    font-size:1.3rem;
    font-weight:500;
    margin-bottom:6px;
  }
  .phase p{color:var(--ink-dim);font-size:1rem;line-height:1.5;}
  .phase.active .num{color:var(--gold);}
  .phase.active h4::after{
    content:'— in progress';
    font-family:'Space Mono',monospace;
    font-size:0.65rem;
    color:var(--gold);
    margin-left:12px;
    letter-spacing:0.05em;
    text-transform:uppercase;
    font-style:normal;
  }

  /* ask / cta */
  .ask{
    background:var(--void-2);
    border-top:1px solid rgba(255,255,255,0.08);
    border-bottom:1px solid rgba(255,255,255,0.08);
  }
  .ask-numbers{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
    gap:40px;
    margin-top:56px;
  }
  .ask-numbers .num{
    font-family:'Space Mono',monospace;
    font-size:clamp(1.8rem,3vw,2.6rem);
    background:linear-gradient(100deg,var(--gold),var(--ember));
    -webkit-background-clip:text;
