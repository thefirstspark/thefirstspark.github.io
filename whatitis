<script>
// ---------- INTERACTIVE VOID ----------
const canvas = document.getElementById('voidCanvas');
const ctx = canvas.getContext('2d');
let W, H, DPR;
function resize(){
  DPR = Math.min(window.devicePixelRatio || 1, 2);
  W = canvas.clientWidth;
  H = canvas.clientHeight;
  canvas.width = W * DPR;
  canvas.height = H * DPR;
  ctx.setTransform(DPR,0,0,DPR,0,0);
}
window.addEventListener('resize', resize);

const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

const palette = ['#ff6a3d','#d4af37','#8b5cf6','#22d3ee','#f472b6'];
const NUM = 90;
let particles = [];
let mouse = {x:null, y:null, active:false};

function initParticles(){
  particles = [];
  for(let i=0;i<NUM;i++){
    particles.push({
      x: Math.random()*W,
      y: Math.random()*H,
      baseX: Math.random()*W,
      baseY: Math.random()*H,
      r: Math.random()*1.6 + 0.6,
      color: palette[Math.floor(Math.random()*palette.length)],
      driftX: (Math.random()-0.5)*0.15,
      driftY: (Math.random()-0.5)*0.15,
      phase: Math.random()*Math.PI*2
    });
  }
}

canvas.addEventListener('mousemove', (e)=>{
  const rect = canvas.getBoundingClientRect();
  mouse.x = e.clientX - rect.left;
  mouse.y = e.clientY - rect.top;
  mouse.active = true;
});
canvas.addEventListener('mouseleave', ()=>{ mouse.active = false; });
canvas.addEventListener('touchmove', (e)=>{
  const rect = canvas.getBoundingClientRect();
  const t = e.touches[0];
  mouse.x = t.clientX - rect.left;
  mouse.y = t.clientY - rect.top;
  mouse.active = true;
}, {passive:true});
canvas.addEventListener('touchend', ()=>{ mouse.active = false; });

let t = 0;
function draw(){
  t += 0.008;
  ctx.clearRect(0,0,W,H);

  // background gradient wash
  const g = ctx.createRadialGradient(W/2,H*0.42,0, W/2,H*0.42, Math.max(W,H)*0.75);
  g.addColorStop(0,'#0d0d16');
  g.addColorStop(1,'#050508');
  ctx.fillStyle = g;
  ctx.fillRect(0,0,W,H);

  // the void core
  const cx = W/2, cy = H*0.44;
  const pull = mouse.active ? 1 : 0;
  const targetX = mouse.active ? mouse.x : cx;
  const targetY = mouse.active ? mouse.y : cy;

  const coreR = 90 + Math.sin(t*1.3)*8;
  const core = ctx.createRadialGradient(targetX,targetY,0, targetX,targetY,coreR*2.4);
  core.addColorStop(0,'rgba(139,92,246,0.55)');
  core.addColorStop(0.35,'rgba(255,106,61,0.18)');
  core.addColorStop(1,'rgba(5,5,8,0)');
  ctx.fillStyle = core;
  ctx.beginPath();
  ctx.arc(targetX,targetY,coreR*2.4,0,Math.PI*2);
  ctx.fill();

  ctx.beginPath();
  ctx.fillStyle = '#050508';
  ctx.arc(targetX,targetY,coreR*0.5,0,Math.PI*2);
  ctx.fill();

  // ring
  ctx.strokeStyle = 'rgba(212,175,55,0.35)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.arc(targetX,targetY,coreR*0.5 + 6,0,Math.PI*2);
  ctx.stroke();

  // particles: drift, and get pulled/repelled near the void
  for(const p of particles){
    const wobbleX = Math.sin(t + p.phase)*6;
    const wobbleY = Math.cos(t + p.phase)*6;
    p.baseX += p.driftX;
    p.baseY += p.driftY;
    if(p.baseX < -20) p.baseX = W+20;
    if(p.baseX > W+20) p.baseX = -20;
    if(p.baseY < -20) p.baseY = H+20;
    if(p.baseY > H+20) p.baseY = -20;

    let px = p.baseX + wobbleX;
    let py = p.baseY + wobbleY;

    if(mouse.active){
      const dx = targetX - px;
      const dy = targetY - py;
      const dist = Math.sqrt(dx*dx+dy*dy) || 1;
      const influence = Math.max(0, 1 - dist/260);
      // orbit-ish pull toward the void but not into it
      px += (dx/dist) * influence * 40 * -1 * (dist < coreR*0.7 ? -1 : 1) * 0.4;
      py += (dy/dist) * influence * 40 * -1 * (dist < coreR*0.7 ? -1 : 1) * 0.4;
    }

    ctx.beginPath();
    ctx.fillStyle = p.color;
    ctx.globalAlpha = 0.75;
    ctx.arc(px, py, p.r, 0, Math.PI*2);
    ctx.fill();
    ctx.globalAlpha = 1;
  }

  if(!reduceMotion){
    requestAnimationFrame(draw);
  }
}

resize();
initParticles();
if(reduceMotion){
  draw(); // draw a single static frame
} else {
  requestAnimationFrame(draw);
}

// ---------- COLOR CODEX ORBS ----------
const codex = [
  {name:'Red', label:'Will', hex:'#e63946'},
  {name:'Ember', label:'Ignition', hex:'#ff6a3d'},
  {name:'Yellow', label:'Joy', hex:'#f2c14e'},
  {name:'Green', label:'The Field', hex:'#5fb85c'},
  {name:'Cyan', label:'Signal', hex:'#22d3ee'},
  {name:'Blue', label:'Mind', hex:'#3b82f6'},
  {name:'Purple', label:'Transformer', hex:'#8b5cf6'},
  {name:'Gold', label:'Orchestrator', hex:'#d4af37'},
  {name:'White', label:'The All', hex:'#f4f1ea'},
  {name:'Rose', label:'The Bond', hex:'#f472b6'},
  {name:'Silver', label:'The Mirror', hex:'#c7c9d1'}
];
const strip = document.getElementById('codexStrip');
codex.forEach(c=>{
  const el = document.createElement('div');
  el.className = 'codex-orb';
  el.style.background = `radial-gradient(circle at 35% 30%, ${c.hex}dd, ${c.hex}22 70%, transparent 100%)`;
  el.style.boxShadow = `inset 0 0 20px ${c.hex}55`;
  const label = document.createElement('span');
  label.className = 'label';
  label.textContent = `${c.name} — ${c.label}`;
  el.appendChild(label);
  strip.appendChild(el);
});
</script>
