<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The First Spark — Selector Model</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Space+Mono:wght@400;700&display=swap');

  :root{
    --void:#050508;
    --void-2:#0a0a12;
    --ember:#ff6a3d;
    --gold:#d4af37;
    --violet:#8b5cf6;
    --cyan:#22d3ee;
    --rose:#f472b6;
    --ink:#ece8e0;
    --ink-dim:#8b8a94;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--void);
    color:var(--ink);
    font-family:'Cormorant Garamond', serif;
    overflow-x:hidden;
  }
  ::selection{background:var(--violet);color:var(--void);}

  .mono{font-family:'Space Mono', monospace;}
  .eyebrow{
    font-family:'Space Mono', monospace;
    font-size:0.72rem;
    letter-spacing:0.28em;
    text-transform:uppercase;
    color:var(--ink-dim);
  }

  /* ---------- HERO / VOID ---------- */
  .hero{
    position:relative;
    height:100vh;
    min-height:640px;
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
    border-bottom:1px solid rgba(255,255,255,0.08);
  }
  #voidCanvas{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    cursor:crosshair;
  }
  .hero-content{
    position:relative;
    z-index:2;
    text-align:center;
    padding:0 24px;
    pointer-events:none;
  }
  .hero-content .eyebrow{margin-bottom:22px;}
  .hero h1{
    font-size:clamp(2.6rem, 7vw, 6rem);
    font-weight:500;
    line-height:1.02;
    letter-spacing:-0.01em;
  }
  .hero h1 em{
    font-style:italic;
    font-weight:400;
    background:linear-gradient(100deg,var(--ember),var(--gold) 40%,var(--violet) 75%,var(--cyan));
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
  }
  .hero p{
    margin-top:26px;
    font-size:clamp(1.05rem,1.6vw,1.35rem);
    color:var(--ink-dim);
    max-width:640px;
    margin-left:auto;
    margin-right:auto;
    font-style:italic;
  }
  .hero-hint{
    position:absolute;
    bottom:34px;
    left:50%;
    transform:translateX(-50%);
    font-size:0.68rem;
    letter-spacing:0.2em;
    color:var(--ink-dim);
    z-index:2;
    opacity:0.7;
  }

  /* ---------- MYTHOLOGY STATEMENT ---------- */
  .myth{
    border-bottom:1px solid rgba(255,255,255,0.08);
    background:radial-gradient(ellipse at 50% 0%, rgba(139,92,246,0.08), transparent 60%);
  }
  .myth-inner{
    max-width:760px;
    margin:0 auto;
    padding:100px 28px;
    text-align:center;
  }
  .myth p.lead{
    font-size:clamp(1.3rem,2.4vw,1.7rem);
    font-style:italic;
    line-height:1.45;
    color:var(--ink);
  }
  .myth p.lead em{
    font-style:italic;
    color:var(--gold);
  }
  .myth p.sub{
    margin-top:22px;
    font-family:'Space Mono',monospace;
    font-size:0.78rem;
    letter-spacing:0.08em;
    color:var(--ink-dim);
    text-transform:uppercase;
  }

  /* ---------- LIVE LINKS ROW ---------- */
  .live-links{
    display:flex;
    flex-wrap:wrap;
    gap:14px;
    margin-top:52px;
    justify-content:center;
  }
  .live-link{
    display:inline-flex;
    align-items:center;
    gap:10px;
    padding:14px 22px;
    border:1px solid rgba(255,255,255,0.16);
    border-radius:999px;
    text-decoration:none;
    color:var(--ink);
    font-family:'Space Mono',monospace;
    font-size:0.78rem;
    letter-spacing:0.03em;
    transition:border-color 0.3s ease, transform 0.3s ease, background 0.3s ease;
    background:rgba(255,255,255,0.02);
  }
  .live-link .dot{
    width:7px;height:7px;border-radius:50%;
    background:var(--dot,var(--ember));
    box-shadow:0 0 8px var(--dot,var(--ember));
  }
  .live-link:hover{
    border-color:var(--dot,var(--ember));
    background:rgba(255,255,255,0.05);
    transform:translateY(-2px);
  }

  /* ---------- SECTIONS ---------- */
  section.block{
    max-width:1080px;
    margin:0 auto;
    padding:140px 28px;
  }
  section.block.tight{padding-top:90px;padding-bottom:90px;}

  h2.section-title{
    font-size:clamp(2rem,4vw,3.2rem);
    font-weight:500;
    line-height:1.08;
    max-width:820px;
  }
  h2.section-title em{font-style:italic;color:var(--gold);}
  .section-lede{
    margin-top:20px;
    max-width:640px;
    font-size:1.2rem;
    color:var(--ink-dim);
    line-height:1.5;
